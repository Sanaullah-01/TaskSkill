{
  "manifest_version": 3,
  "name": "TaskSkill Extension",
  "version": "1.0.0",
  "description": "Quickly add tasks and view due dates from anywhere.",
  "action": {
    "default_popup": "src/popup/index.html"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
